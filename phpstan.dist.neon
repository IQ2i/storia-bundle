includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon

parameters:
    level: 7
    paths:
        - src
        - tests
    excludePaths:
        - tests/TestApplication
    fileExtensions:
        - php
    ignoreErrors:
        # The types of the fixtures and data providers are not worth a docblock
        -
            identifier: missingType.iterableValue
            path: tests/*
        # Depends on the installed version of Twig and ux-twig-component
        -
            identifier: function.alreadyNarrowedType
            path: tests/Controls/TwigTestCase.php
        # A private method is there to check that the providers cannot call it
        -
            identifier: method.unused
            path: tests/Fixtures/ProductFactory.php
        # The test walks the tree of menus and items
        -
            identifier: method.notFound
            path: tests/Menu/MenuBuilderTest.php
