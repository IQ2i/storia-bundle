includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon

parameters:
    level: 5
    paths:
        - src
    fileExtensions:
        - php
    ignoreErrors:
        # The trait is for the test suites of the projects, tests/ is out of the analysed paths
        -
            identifier: trait.unused
            path: src/Test/PHPUnit/StoriaTestCaseTrait.php
