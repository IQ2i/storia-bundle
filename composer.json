{
  "name": "iq2i/storia-bundle",
  "type": "symfony-bundle",
  "description": "UI Storia bundle",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "michelf/php-markdown": "^2.0",
    "symfony/asset": "^6.4|^7.0|^8.0",
    "symfony/config": "^6.4|^7.0|^8.0",
    "symfony/console": "^6.4|^7.0|^8.0",
    "symfony/dependency-injection": "^6.4|^7.0|^8.0",
    "symfony/deprecation-contracts": "^2.5|^3.0",
    "symfony/expression-language": "^6.4|^7.0|^8.0",
    "symfony/filesystem": "^6.4|^7.0|^8.0",
    "symfony/finder": "^6.4|^7.0|^8.0",
    "symfony/http-foundation": "^6.4|^7.0|^8.0",
    "symfony/http-kernel": "^6.4|^7.0|^8.0",
    "symfony/process": "^6.4|^7.0|^8.0",
    "symfony/routing": "^6.4|^7.0|^8.0",
    "symfony/yaml": "^6.4|^7.0|^8.0",
    "twig/twig": "^3.8"
  },
  "suggest": {
    "symfony/ux-twig-component": "Required to use the component view type (^2.16)",
    "symfony/form": "Required to use the form view type",
    "sebastian/diff": "Pretty snapshot diffs in storia:test",
    "symfony/ai-mate": "Discovers the UI Storia skill shipped in skills/ (vendor/bin/mate discover)"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.52",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^10.5",
    "rector/rector": "^2.0",
    "symfony/browser-kit": "^6.4|^7.0|^8.0",
    "symfony/css-selector": "^6.4|^7.0|^8.0",
    "symfony/form": "^6.4|^7.0|^8.0",
    "symfony/framework-bundle": "^6.4|^7.0|^8.0",
    "symfony/runtime": "^6.4|^7.0|^8.0",
    "symfony/string": "^6.4|^7.0|^8.0",
    "symfony/ux-twig-component": "^2.16|^3.0",
    "symfony/web-profiler-bundle": "^6.4|^7.0|^8.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/runtime": true
    },
    "audit": {
      "block-insecure": false
    }
  },
  "autoload": {
    "psr-4": {
      "IQ2i\\StoriaBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IQ2i\\StoriaBundle\\Tests\\TestApplication\\": "tests/TestApplication/src",
      "IQ2i\\StoriaBundle\\Tests\\": "tests"
    }
  },
  "extra": {
    "ai-mate": {
      "skills": [
        "skills"
      ]
    }
  }
}
