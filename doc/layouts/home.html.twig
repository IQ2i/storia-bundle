{% extends '_base.html.twig' %}

{% block content %}
    <section class="hero-header">
        <div class="hero-header__text">
            <div class="hero-header__text-header">
                <h1>Your design system lives in your Symfony project, built by your integrators</h1>
                <p>UI Storia is the design-system workbench for Symfony: document and test the real Twig templates and components of your application, without porting them to JavaScript.</p>
            </div>
            <div class="hero-header__actions">
                <a class="btn btn--primary btn--large" href="{{ url('docs/getting-started') }}">Get started</a>
                <a class="btn btn--secondary btn--large" href="/demo/">See the demo</a>
            </div>
        </div>

        <div class="hero-header__image">
            <img src="{{ asset('img/home-ui-example.png') }}" alt="Screenshot of UI Storia">
        </div>

        <div class="hero-header__blur"></div>
    </section>

    <section id="integration" class="integration">
        <div class="integration__content">
            <div class="integration__content_text">
                <h2>Real templates, no PHP required, variants that are tests</h2>
                <ul>
                    <li><strong>Real templates.</strong> UI Storia renders the templates and Twig Components of your project with your own Twig environment. Unlike Fractal or Storybook, nothing is ported to JavaScript, so you can use the latest Twig features safely.</li>
                    <li><strong>No PHP required.</strong> An integrator writes an anonymous component and a YAML file of variants. No controller, no class, no database.</li>
                    <li><strong>Variants are tests.</strong> <code>storia:test</code> renders every variant and compares it with a snapshot, so a catalog that documents your components also protects them.</li>
                </ul>
                <p><a href="{{ url('docs/why-not-storybook') }}">Why not Storybook?</a> · <a href="{{ url('docs/workflow') }}">The workflow</a></p>
            </div>

            <div class="integration__content_image">
                <img src="{{ asset('img/home-integration.png') }}" alt="Integration of UI Storia in your Symfony application" loading="lazy">
            </div>
            <div class="integration__blur"></div>
        </div>
    </section>
{% endblock %}
