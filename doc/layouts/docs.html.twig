{% extends '_base.html.twig' %}

{% block body_class %}page-docs{% endblock %}

{% block header_documentation %}{% endblock %}

{% block content %}
    <div class="docs">
        <nav class="docs__nav" aria-label="Documentation">
            <p class="docs__nav-title"><a href="{{ url('docs') }}"{% if page.id == 'docs' %} class="is-active" aria-current="page"{% endif %}>Documentation</a></p>
            <ul>
                {% for entry in site.menus.docs|sort_by_weight %}
                    <li>
                        <a href="{{ url(entry.id) }}"{% if entry.id == page.id %} class="is-active" aria-current="page"{% endif %}>{{ entry.name }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>

        <article class="docs__content markdown-body">
            <h1>{{ page.title }}</h1>
            {{ page.content }}
        </article>
    </div>

    <script>
        document.querySelector('.docs__nav .is-active')?.scrollIntoView({block: 'nearest', inline: 'center'});
    </script>
{% endblock %}
